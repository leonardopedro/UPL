@article{seifertSupernovaeEvidenceFoundational2025,
  title        = {Supernovae Evidence for Foundational Change to Cosmological Models},
  author       = {Seifert, Antonia and Lane, Zachary G and Galoppo, Marco and Ridden-Harper, Ryan and Wiltshire, David L},
  date         = {2025-02-01},
  journaltitle = {Monthly Notices of the Royal Astronomical Society: Letters},
  volume       = {537},
  number       = {1},
  pages        = {L55-L60},
  issn         = {1745-3925},
  doi          = {10.1093/mnrasl/slae112},
  url          = {https://doi.org/10.1093/mnrasl/slae112},
  urldate      = {2025-01-01},
  abstract     = {We present a new, cosmologically model-independent, statistical analysis of the Pantheon\$+\$ Type Ia Supernovae spectroscopic data set, improving a standard methodology adopted by Lane et~al. We use the Tripp equation~for supernova standardization alone, thereby avoiding any potential correlation in the stretch and colour distributions. We compare the standard homogeneous cosmological model, i.e. spatially flat \$\textbackslash Lambda\$ cold dark matter (\$\textbackslash Lambda\$CDM), and the timescape cosmology which invokes backreaction of inhomogeneities. Timescape, while statistically homogeneous and isotropic, departs from average Friedmann–Lemaître–Robertson–Walker evolution, and replaces dark energy by kinetic gravitational energy and its gradients, in explaining independent cosmological observations. When considering the entire Pantheon\$+\$ sample, we find very strong evidence (\$\textbackslash ln B\textbackslash gt 5\$) in favour of timescape over \$\textbackslash Lambda\$CDM. Furthermore, even restricting the sample to redshifts beyond any conventional scale of statistical homogeneity, \$z \textbackslash gt 0.075\$, timescape is preferred over \$\textbackslash Lambda\$CDM with \$\textbackslash ln B\textbackslash gt 1\$. These results provide evidence for a need to revisit the foundations of theoretical and observational cosmology.},
  file         = {/home/leo/Zotero/storage/QKDVUSTH/Seifert et al. - 2025 - Supernovae evidence for foundational change to cosmological models.pdf;/home/leo/Zotero/storage/4UTTUWN5/7926647.html}
}

