@article{gjergoImpactEarlyMassive2025,
  title        = {The Impact of Early Massive Galaxy Formation on the Cosmic Microwave Background},
  author       = {Gjergo, Eda and Kroupa, Pavel},
  date         = {2025-08-01},
  journaltitle = {Nuclear Physics B},
  volume       = {1017},
