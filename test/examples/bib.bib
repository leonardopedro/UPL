  keywords     = {Applied mathematics,Biomedical engineering,Computational science},
  file         = {/home/leo/Zotero/storage/E6RH4QFV/Yin et al. - 2024 - A scalable framework for learning the geometry-dependent solution operators of partial differential.pdf}
