  title        = {Interaction-Free Quantum Measurements: {{A}} Paradox?},
  shorttitle   = {Interaction-Free Quantum Measurements},
  author       = {Dicke, R. H.},
  date         = {1981-10-01},
  journaltitle = {American Journal of Physics},
