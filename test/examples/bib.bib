  title        = {{{BioAutoMATED}}: {{An}} End-to-End Automated Machine Learning Tool for Explanation and Design of Biological Sequences},
  shorttitle   = {{{BioAutoMATED}}},
  author       = {Valeri, Jacqueline A. and Soenksen, Luis R. and Collins, Katherine M. and Ramesh, Pradeep and Cai, George and Powers, Rani and Angenent-Mari, Nicolaas M. and Camacho, Diogo M. and Wong, Felix and Lu, Timothy K. and Collins, James J.},
