@online{anguloExperimentalEvidenceThat2024,
  title        = {Experimental Evidence That a Photon Can Spend a Negative Amount of Time in an Atom Cloud},
  author       = {Angulo, Daniela and Thompson, Kyle and Nixon, Vida-Michelle and Jiao, Andy and Wiseman, Howard M. and Steinberg, Aephraim M.},
  date         = {2024-09-05},
  url          = {https://arxiv.org/abs/2409.03680v1},
  urldate      = {2024-10-03},
  abstract     = {When a pulse of light traverses a material, it incurs a time delay referred to as the group delay. Should the group delay experienced by photons be attributed to the time they spend as atomic excitations? However reasonable this connection may seem, it appears problematic when the frequency of the light is close to the atomic resonance, as the group delay becomes negative in this regime. To address this question, we use the cross-Kerr effect to probe the degree of atomic excitation caused by a resonant transmitted photon, by measuring the phase shift on a separate beam that is weak and off-resonant. Our results, over a range of pulse durations and optical depths, are consistent with the recent theoretical prediction that the mean atomic excitation time caused by a transmitted photon (as measured via the time integral of the observed phase shift) equals the group delay experienced by the light. Specifically, we measure mean atomic excitation times ranging from \$(-0.82\textbackslash pm 0.31) \textbackslash tau\_0\$ for the most narrowband pulse to \$(0.54\textbackslash pm 0.28) \textbackslash tau\_0\$ for the most broadband pulse, where \$\textbackslash tau\_0\$ is the non-post-selected excitation time, given by the scattering (absorption) probability multiplied by the atomic lifetime \$\textbackslash tau\_\{\textbackslash rm sp\}\$. These results suggest that negative values taken by times such as the group delay have more physical significance than has generally been appreciated.},
  langid       = {english},
  organization = {arXiv.org},
  file         = {/home/leo/Zotero/storage/LEZ22LIG/Angulo et al. - 2024 - Experimental evidence that a photon can spend a negative amount of time in an atom cloud.pdf}
}

