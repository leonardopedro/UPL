@article{jacobsonThermodynamicsSpacetimeEinstein1995,
  title        = {Thermodynamics of {{Spacetime}}: {{The Einstein Equation}} of {{State}}},
  shorttitle   = {Thermodynamics of {{Spacetime}}},
  author       = {Jacobson, Ted},
  date         = {1995-08-14},
  journaltitle = {Phys. Rev. Lett.},
  volume       = {75},
  number       = {7},
  eprint       = {gr-qc/9504004},
  eprinttype   = {arXiv},
  pages        = {1260--1263},
  issn         = {0031-9007, 1079-7114},
  doi          = {10.1103/PhysRevLett.75.1260},
  url          = {http://arxiv.org/abs/gr-qc/9504004},
  urldate      = {2025-03-30},
  abstract     = {The Einstein equation is derived from the proportionality of entropy and horizon area together with the fundamental relation \$\textbackslash delta Q=TdS\$ connecting heat, entropy, and temperature. The key idea is to demand that this relation hold for all the local Rindler causal horizons through each spacetime point, with \$\textbackslash delta Q\$ and \$T\$ interpreted as the energy flux and Unruh temperature seen by an accelerated observer just inside the horizon. This requires that gravitational lensing by matter energy distorts the causal structure of spacetime in just such a way that the Einstein equation holds. Viewed in this way, the Einstein equation is an equation of state. This perspective suggests that it may be no more appropriate to canonically quantize the Einstein equation than it would be to quantize the wave equation for sound in air.},
  keywords     = {General Relativity and Quantum Cosmology,High Energy Physics - Theory},
  note         = {Comment: 8 pages, 1 figure. Revised version has core unchanged but paper rewritten and expanded to clarify the reasoning and to emphasize some points. One figure added},
  file         = {/home/leo/Zotero/storage/WY669R3P/Jacobson - 1995 - Thermodynamics of Spacetime The Einstein Equation of State.pdf;/home/leo/Zotero/storage/6GB78HM9/9504004.html}
}

