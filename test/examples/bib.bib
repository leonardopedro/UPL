@article{villas-boasBrightDarkStates2025,
  title        = {Bright and {{Dark States}} of {{Light}}: {{The Quantum Origin}} of {{Classical Interference}}},
  shorttitle   = {Bright and {{Dark States}} of {{Light}}},
  author       = {Villas-Boas, Celso J. and Máximo, Carlos E. and Paulino, Paulo J. and Bachelard, Romain P. and Rempe, Gerhard},
