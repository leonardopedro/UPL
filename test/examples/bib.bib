@article{moranBellInequalitiesOverlapping2023,
  title        = {Bell {{Inequalities}} with {{Overlapping Measurements}}},
  author       = {Morán, Moisés Bermejo and Pozas-Kerstjens, Alejandro and Huber, Felix},
  date         = {2023-08-25},
  journaltitle = {Phys. Rev. Lett.},
  volume       = {131},
