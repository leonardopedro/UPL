@online{bakshiHighTemperatureGibbsStates2024,
  title       = {High-{{Temperature Gibbs States}} Are {{Unentangled}} and {{Efficiently Preparable}}},
  author      = {Bakshi, Ainesh and Liu, Allen and Moitra, Ankur and Tang, Ewin},
  date        = {2024-03-25},
  eprint      = {2403.16850},
  eprinttype  = {arXiv},
  eprintclass = {math-ph, physics:quant-ph},
  doi         = {10.48550/arXiv.2403.16850},
  url         = {http://arxiv.org/abs/2403.16850},
  urldate     = {2024-08-29},
  abstract    = {We show that thermal states of local Hamiltonians are separable above a constant temperature. Specifically, for a local Hamiltonian \$H\$ on a graph with degree \$\textbackslash mathfrak\{d\}\$, its Gibbs state at inverse temperature \$\textbackslash beta\$, denoted by \$\textbackslash rho =e\textasciicircum\{-\textbackslash beta H\}/ \textbackslash textrm\{tr\}(e\textasciicircum\{-\textbackslash beta H\})\$, is a classical distribution over product states for all \$\textbackslash beta {$<$} 1/(c\textbackslash mathfrak\{d\})\$, where \$c\$ is a constant. This sudden death of thermal entanglement upends conventional wisdom about the presence of short-range quantum correlations in Gibbs states. Moreover, we show that we can efficiently sample from the distribution over product states. In particular, for any \$\textbackslash beta {$<$} 1/( c \textbackslash mathfrak\{d\}\textasciicircum 3)\$, we can prepare a state \$\textbackslash epsilon\$-close to \$\textbackslash rho\$ in trace distance with a depth-one quantum circuit and \$\textbackslash textrm\{poly\}(n) \textbackslash log(1/\textbackslash epsilon)\$ classical overhead. A priori the task of preparing a Gibbs state is a natural candidate for achieving super-polynomial quantum speedups, but our results rule out this possibility above a fixed constant temperature.},
  pubstate    = {prepublished},
  keywords    = {Computer Science - Data Structures and Algorithms,Mathematical Physics,Quantum Physics},
  file        = {/home/leo/Zotero/storage/89XLPJ6S/Bakshi et al. - 2024 - High-Temperature Gibbs States are Unentangled and Efficiently Preparable.pdf;/home/leo/Zotero/storage/7Q7XCLLD/2403.html}
}

