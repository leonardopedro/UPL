@article{cheungBootstrapPrincipleSpectrum2024,
  title        = {Bootstrap {{Principle}} for the {{Spectrum}} and {{Scattering}} of {{Strings}}},
  author       = {Cheung, Clifford and Hillman, Aaron and Remmen, Grant N.},
  date         = {2024-12-17},
