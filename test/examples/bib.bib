@online{turokGravitationalEntropyFlatness2022,
  title       = {Gravitational Entropy and the Flatness, Homogeneity and Isotropy Puzzles},
  author      = {Turok, Neil and Boyle, Latham},
  date        = {2022-01-18},
  eprint      = {2201.07279},
  eprinttype  = {arXiv},
  eprintclass = {hep-th},
  doi         = {10.48550/arXiv.2201.07279},
  url         = {http://arxiv.org/abs/2201.07279},
  urldate     = {2025-05-27},
  abstract    = {We suggest a new explanation for the observed large scale flatness, homogeneity and isotropy of the universe. The basic ingredients are elementary and well-known, namely Einstein's theory of gravity and Hawking's method of computing gravitational entropy. The new twist is provided by the boundary conditions we recently proposed for "big bang" type singularities dominated by conformal matter, enforcing \$CPT\$ symmetry and analyticity. Here, we show that, besides allowing us to describe the big bang, these boundary conditions allow new gravitational instantons, enabling us to calculate the gravitational entropy of cosmologies which include radiation, dark energy and space curvature of either sign. We find the gravitational entropy of these universes, \$S\_g \textbackslash sim S\_\textbackslash Lambda\textasciicircum\{1/ 4\} S\_r\$, where \$S\_\textbackslash Lambda\$ is the famous de Sitter entropy and \$S\_r\$ is the total entropy in radiation. To the extent that \$S\_g\$ exceeds \$S\_\textbackslash Lambda\$, the most probable universe is flat. By analysing the perturbations about our new instantons, we argue it is also homogeneous and isotropic on large scales.},
  pubstate    = {prepublished},
  keywords    = {Astrophysics - Cosmology and Nongalactic Astrophysics,General Relativity and Quantum Cosmology,High Energy Physics - Phenomenology,High Energy Physics - Theory},
  note        = {Comment: 5 pages, 4 figures},
  file        = {/home/leo/Zotero/storage/32FCM2FI/Turok and Boyle - 2022 - Gravitational entropy and the flatness, homogeneity and isotropy puzzles.pdf;/home/leo/Zotero/storage/B2VF656N/2201.html}
}

