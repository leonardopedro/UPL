@article{yinScalableFrameworkLearning2024,
  title        = {A Scalable Framework for Learning the Geometry-Dependent Solution Operators of Partial Differential Equations},
  author       = {Yin, Minglang and Charon, Nicolas and Brody, Ryan and Lu, Lu and Trayanova, Natalia and Maggioni, Mauro},
  date         = {2024-12},
