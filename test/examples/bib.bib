@article{vermeulenPhotonCountingInterferometryDetect2025,
  title        = {Photon-{{Counting Interferometry}} to {{Detect Geontropic Space-Time Fluctuations}} with {{GQuEST}}},
  author       = {Vermeulen, Sander M. and Cullen, Torrey and Grass, Daniel and MacMillan, Ian A. O. and Ramirez, Alexander J. and Wack, Jeffrey and Korzh, Boris and Lee, Vincent S. H. and Zurek, Kathryn M. and Stoughton, Chris and McCuller, Lee},
