@article{wangViolationBellInequality2025,
  title        = {Violation of {{Bell}} Inequality with Unentangled Photons},
  author       = {Wang, Kai and Hou, Zhaohua and Qian, Kaiyi and Chen, Leizhen and Krenn, Mario and Aspelmeyer, Markus and Zeilinger, Anton and Zhu, Shining and Ma, Xiao-Song},
  date         = {2025-08},
  journaltitle = {Science Advances},
