@online{haradaCellularEntityRetaining2025,
  title       = {A Cellular Entity Retaining Only Its Replicative Core: {{Hidden}} Archaeal Lineage with an Ultra-Reduced Genome},
  shorttitle  = {A Cellular Entity Retaining Only Its Replicative Core},
  author      = {Harada, Ryo and Nishimura, Yuki and Nomura, Mami and Yabuki, Akinori and Shiba, Kogiku and Inaba, Kazuo and Inagaki, Yuji and Nakayama, Takuro},
  date        = {2025-05-02},
  eprinttype  = {bioRxiv},
  eprintclass = {New Results},
  pages       = {2025.05.02.651781},
  doi         = {10.1101/2025.05.02.651781},
  url         = {https://www.biorxiv.org/content/10.1101/2025.05.02.651781v1},
  urldate     = {2025-07-03},
  abstract    = {Defining the minimal genetic requirements for cellular life remains a fundamental question in biology. Genomic exploration continually reveals novel microbial lineages, often exhibiting extreme genome reduction, particularly within symbiotic relationships. Here, we report the discovery of Candidatus Sukunaarchaeum mirabile, a novel archaeon with an unprecedentedly small genome of only 238 kbp —less than half the size of the smallest previously known archaeal genome— from a dinoflagellate-associated microbial community. Phylogenetic analyses place Sukunaarchaeum as a deeply branching lineage within the tree of Archaea, representing a novel major branch distinct from established phyla. Environmental sequence data indicate that sequences closely related to Sukunaarchaeum form a diverse and previously overlooked clade in microbial surveys. Its genome is profoundly stripped-down, lacking virtually all recognizable metabolic pathways, and primarily encoding the machinery for its replicative core: DNA replication, transcription, and translation. This suggests an unprecedented level of metabolic dependence on a host, a condition that challenges the functional distinctions between minimal cellular life and viruses. The discovery of Sukunaarchaeum pushes the conventional boundaries of cellular life and highlights the vast unexplored biological novelty within microbial interactions, suggesting that further exploration of symbiotic systems may reveal even more extraordinary life forms, reshaping our understanding of cellular evolution. {$<$}img class="highwire-fragment fragment-image" alt="Figure" src="https://www.biorxiv.org/content/biorxiv/early/2025/05/02/2025.05.02.651781/F1.medium.gif" width="440" height="271"/{$>$}Download figureOpen in new tabGraphical Abstract},
  langid      = {english},
  pubstate    = {prepublished},
  file        = {/home/leo/Zotero/storage/ULBENTBW/Harada et al. - 2025 - A cellular entity retaining only its replicative core Hidden archaeal lineage with an ultra-reduced.pdf}
}

