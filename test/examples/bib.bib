@online{salvadori$D$NetsInteractionBasedSystem2025,
  title       = {\${{Δ}}\$-{{Nets}}: {{Interaction-Based System}} for {{Optimal Parallel}} \$λ\$-{{Reduction}}},
  shorttitle  = {\${{Δ}}\$-{{Nets}}},
  author      = {Salvadori, Daniel Augusto Rizzi},
  date        = {2025-06-20},
  eprint      = {2505.20314},
  eprinttype  = {arXiv},
  eprintclass = {cs},
  doi         = {10.48550/arXiv.2505.20314},
  url         = {http://arxiv.org/abs/2505.20314},
  urldate     = {2025-08-01},
  abstract    = {I present a model of universal parallel computation called \$\textbackslash Delta\$-Nets, and a method to translate \$\textbackslash lambda\$-terms into \$\textbackslash Delta\$-nets and back. Together, the model and the method constitute an algorithm for optimal parallel \$\textbackslash lambda\$-reduction, solving the longstanding enigma with groundbreaking clarity. I show that the \$\textbackslash lambda\$-calculus can be understood as a projection of \$\textbackslash Delta\$-Nets\$-\$one that severely restricts the structure of sharing, among other drawbacks. Unhindered by these restrictions, the \$\textbackslash Delta\$-Nets model opens the door to new parallel programming language implementations and computer architectures that are more efficient and performant than previously possible.},
  pubstate    = {prepublished},
  keywords    = {Computer Science - Distributed Parallel and Cluster Computing,Computer Science - Hardware Architecture,Computer Science - Logic in Computer Science,Computer Science - Programming Languages},
  file        = {/home/leo/Zotero/storage/98PJHNKQ/Salvadori - 2025 - $Δ$-Nets Interaction-Based System for Optimal Parallel $λ$-Reduction.pdf;/home/leo/Zotero/storage/ZCBRQ9I4/2505.html}
}

