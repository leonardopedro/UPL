  title        = {A {{Model}} of the {{Cosmos}} in the Ancient {{Greek Antikythera Mechanism}}},
  author       = {Freeth, Tony and Higgon, David and Dacanalis, Aris and MacDonald, Lindsay and Georgakopoulou, Myrto and Wojcik, Adam},
